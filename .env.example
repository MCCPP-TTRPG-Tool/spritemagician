# Sprite Magician — optional environment configuration
#
# You do NOT need this file. Enter API keys in the app's Settings screen
# instead; they are saved to <data dir>/settings.json.
# Values here are used only as a fallback for people running from a terminal.

# Where sprites, animations, projects and settings are stored.
# Default: ~/SpriteMagician (terminal) or Documents/SpriteMagician (desktop app)
# SPRITEMAGICIAN_DATA_DIR=C:\Users\you\SpriteMagician

# Required for generation
# REPLICATE_API_TOKEN=r8_...

# Optional providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Self-hosted RunPod endpoints (advanced, see runpod/ folder)
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_IMAGE_EDIT_ENDPOINT_ID=
# RUNPOD_KONTEXT_IMAGE_ENDPOINT_ID=
# RUNPOD_QWEN_IMAGE_ENDPOINT_ID=
# POSE_ENDPOINT_ID=

# Max request body for the local server (large base64 uploads)
# BODY_SIZE_LIMIT=512M
