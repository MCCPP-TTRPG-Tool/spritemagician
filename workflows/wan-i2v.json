{
  "_comment": "Sprite Magician - Wan 2.2 TI2V 5B image-to-video (ComfyUI API format). Placeholders {{IMAGE}} {{PROMPT}} {{SEED}} {{NUM_FRAMES}} {{FPS}} are filled in by the app. Model files: diffusion_models/wan2.2_ti2v_5B_fp16.safetensors, text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors, vae/wan2.2_vae.safetensors (from Comfy-Org/Wan_2.2_ComfyUI_Repackaged on Hugging Face). Edit this file freely; the app only needs the placeholders.",
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Wan 2.2 TI2V 5B" },
    "inputs": { "unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load UMT5 text encoder" },
    "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Wan 2.2 VAE" },
    "inputs": { "vae_name": "wan2.2_vae.safetensors" }
  },
  "4": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Shift" },
    "inputs": { "model": ["1", 0], "shift": 8 }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt" },
    "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt" },
    "inputs": { "clip": ["2", 0], "text": "blurry, low quality, deformed, extra limbs, text, watermark, camera movement, zoom, background changes, flicker" }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Input sprite" },
    "inputs": { "image": "{{IMAGE}}", "upload": "image" }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "_meta": { "title": "Wan 2.2 I2V latent" },
    "inputs": { "vae": ["3", 0], "start_image": ["7", 0], "width": 832, "height": 480, "length": "{{NUM_FRAMES}}", "batch_size": 1 }
  },
  "9": {
    "class_type": "KSampler",
    "_meta": { "title": "Sample" },
    "inputs": {
      "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["8", 0],
      "seed": "{{SEED}}", "steps": 20, "cfg": 5, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] }
  },
  "11": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Create video" },
    "inputs": { "images": ["10", 0], "fps": "{{FPS}}" }
  },
  "12": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Save video" },
    "inputs": { "video": ["11", 0], "filename_prefix": "video/sprite-magician", "format": "mp4", "codec": "h264" }
  }
}
