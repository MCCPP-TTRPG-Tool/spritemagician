# RunPod Serverless: ControlNet + IP-Adapter Pose Generation
# Models: SD 1.5 + ControlNet OpenPose + IP-Adapter Plus
#
# Build: docker build -f Dockerfile.pose -t pose-handler .
# Test:  docker run --gpus all -p 8000:8000 pose-handler

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements_pose.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements_pose.txt

# Pre-download ALL models during build (so cold starts are fast)
RUN python -c "\
from diffusers import StableDiffusionControlNetPipeline, ControlNetModel; \
import torch; \
print('Downloading ControlNet OpenPose...'); \
cn = ControlNetModel.from_pretrained('lllyasviel/control_v11p_sd15_openpose', torch_dtype=torch.float16); \
print('Downloading SD 1.5...'); \
pipe = StableDiffusionControlNetPipeline.from_pretrained( \
    'runwayml/stable-diffusion-v1-5', \
    controlnet=cn, \
    torch_dtype=torch.float16, \
    safety_checker=None, \
    requires_safety_checker=False); \
print('Downloading IP-Adapter Plus...'); \
pipe.load_ip_adapter('h94/IP-Adapter', subfolder='models', weight_name='ip-adapter-plus_sd15.bin'); \
print('✓ All models downloaded'); \
"

# Copy handler
COPY pose_handler.py .

# Verify handler imports
RUN python -c "\
import sys; sys.path.insert(0, '/app'); \
exec(open('pose_handler.py').read().split('runpod.serverless.start')[0]); \
print('✓ pose_handler imports OK'); \
"

CMD ["python", "-u", "pose_handler.py"]
